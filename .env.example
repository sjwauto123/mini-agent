# Copy this file to .env and fill in a new key.
DEEPSEEK_API_KEY=

# Set to 1 only when running paid real-model tests.
RUN_REAL_MODEL_TESTS=0

# NOTE: VITE_API_TARGET does NOT belong in this file.
# Vite loads its own env directory (frontend/), so a VITE_* variable placed in
# this root .env is silently ignored by the dev server. Set it in the shell
# (see README "初始化与启动") or copy frontend/.env.example to frontend/.env.
